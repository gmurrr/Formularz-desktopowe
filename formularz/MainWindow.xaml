<Window x:Class="formularz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:formularz"
        mc:Ignorable="d"
        Title="Formularz Użytkownika" Height="350" Width="400">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
  
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Imię:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtImie" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Płeć:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
            <RadioButton x:Name="rbKobieta" Content="Kobieta" GroupName="Plec" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbMezczyzna" Content="Mężczyzna" GroupName="Plec" VerticalAlignment="Center"/>
        </StackPanel>

        <Label Grid.Row="2" Grid.Column="0" Content="Data urodzenia:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <DatePicker x:Name="dpDataUrodzenia" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,0,0,10"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Dodatkowe info:" VerticalAlignment="Top" Margin="0,0,10,10"/>
        <TextBox x:Name="txtInformacje" Grid.Row="3" Grid.Column="1" 
                 TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnZatwierdz" Content="Zatwierdź" Width="90" Height="30" Margin="0,0,10,0" Click="BtnZatwierdz_Click"/>
            <Button x:Name="btnAnuluj" Content="Anuluj" Width="90" Height="30" Click="BtnAnuluj_Click"/>
        </StackPanel>
    </Grid>
</Window>